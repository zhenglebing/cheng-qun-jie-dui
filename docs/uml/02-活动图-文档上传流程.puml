@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam activity {
  BackgroundColor #E7F0F2
  BorderColor #1B4B5A
  DiamondBackgroundColor #FAF3E2
  DiamondBorderColor #C89B3C
}

start
:学生进入工作台;
:选择本地文件（PDF / TXT）;
:前端校验文件格式与大小;
if (格式合法且不超过 20MB？) then (否)
  :提示错误信息\n仅支持 PDF / TXT，单文件 ≤ 20MB;
  stop
else (是)
endif
:界面显示上传进度条;
:通过扣子 WebSDK 提交文件;
:文件解析插件提取文本内容;
if (文本可正常提取？) then (否)
  :文档标记为「解析失败」;
  :提示改用文字版 PDF 或 TXT;
  :提供「重新上传」入口;
  stop
else (是)
  :生成文档对象并写入本地会话存储;
  :列表状态置为「已解析」;
  :设为当前选用资料;
  :进入对话主界面;
  :累计上传次数 +1;
  stop
endif
@enduml
