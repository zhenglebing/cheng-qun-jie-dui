@startuml
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam usecase {
  BackgroundColor #E7F0F2
  BorderColor #1B4B5A
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B4B5A
}
skinparam rectangle {
  BackgroundColor #FCFDFD
  BorderColor #1B4B5A
}

actor "在校学生" as student
actor "团队管理员" as admin
actor "扣子智能体平台" as coze <<外部系统>>

rectangle "Review-AI 大学生课程复习助手" {
  usecase "上传课程文档" as UC1
  usecase "解析文档内容" as UC1a
  usecase "提炼考点" as UC2
  usecase "生成自测习题" as UC3
  usecase "知识点答疑" as UC4
  usecase "回看历史会话" as UC5
  usecase "配置智能体人设" as UC6
  usecase "维护指令模板" as UC7
  usecase "查看会话记录" as UC8
  usecase "监控调用额度" as UC9
}

student --> UC1
student --> UC2
student --> UC3
student --> UC4
student --> UC5

admin --> UC6
admin --> UC7
admin --> UC8
admin --> UC9

UC1 ..> UC1a : <<include>>
UC2 ..> UC1a : <<include>>
UC3 ..> UC1a : <<include>>
UC4 ..> UC1a : <<include>>
UC1a --> coze : <<调用>>
@enduml
