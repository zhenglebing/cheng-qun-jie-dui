@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam object {
  BackgroundColor #E7F0F2
  BorderColor #1B4B5A
}
skinparam arrow {
  Color #1B4B5A
  FontColor #16262E
}

' 协作图（通信图）：以「快捷指令问答」场景为例，展示对象间的协作与消息编号
object "1 : 对话页面\nChatView" as UI
object "2 : 会话控制器\nChatController" as C
object "3 : SDK 网关\nCozeGateway" as G
object "4 : 智能体\nReviewAgent" as A
object "5 : 会话存储\nSessionStore" as S

UI --> C : 1.1 触发指令\n（提炼考点）
C --> S : 1.2 读取上下文
S --> C : 1.3 返回文档文本
C --> G : 1.4 提交提示词
G --> A : 1.5 转发请求
A --> A : 1.6 校验问题域
A --> G : 1.7 返回结构化结果
G --> C : 1.8 回调结果
C --> S : 1.9 持久化会话
C --> UI : 1.10 刷新视图
@enduml
