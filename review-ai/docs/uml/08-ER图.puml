@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor #FCFDFD
  BorderColor #1B4B5A
  HeaderBackgroundColor #E7F0F2
}

entity "student\n学生" as student {
  * id : BIGINT <<PK>>
  --
  * device_id : VARCHAR(64) <<UK>>
  nickname : VARCHAR(32)
  * created_at : DATETIME
  last_active_at : DATETIME
}

entity "document\n课程文档" as document {
  * id : BIGINT <<PK>>
  --
  * student_id : BIGINT <<FK>>
  * file_name : VARCHAR(255)
  * file_type : VARCHAR(8)
  * file_size : INT
  * parse_status : TINYINT
  content_digest : CHAR(64)
  page_count : SMALLINT
  * uploaded_at : DATETIME
  deleted_at : DATETIME
}

entity "conversation\n复习会话" as conversation {
  * id : BIGINT <<PK>>
  --
  * student_id : BIGINT <<FK>>
  document_id : BIGINT <<FK>>
  title : VARCHAR(64)
  command_count : SMALLINT
  * status : TINYINT
  * started_at : DATETIME
  last_active_at : DATETIME
}

entity "message\n会话消息" as message {
  * id : BIGINT <<PK>>
  --
  * conversation_id : BIGINT <<FK>>
  * seq_no : SMALLINT
  * role : TINYINT
  * content : TEXT
  command_id : BIGINT <<FK>>
  token_used : INT
  * created_at : DATETIME
}

entity "command_template\n快捷指令模板" as command_template {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(32) <<UK>>
  * button_text : VARCHAR(16)
  * prompt_template : TEXT
  * status : TINYINT
  updated_by : BIGINT <<FK>>
  * updated_at : DATETIME
}

entity "agent_config\n智能体配置" as agent_config {
  * id : BIGINT <<PK>>
  --
  * agent_name : VARCHAR(64)
  * persona_prompt : TEXT
  format_rules : TEXT
  fallback_reply : VARCHAR(255)
  * version : VARCHAR(16)
  * status : TINYINT
  published_at : DATETIME
  updated_by : BIGINT <<FK>>
}

entity "call_log\n调用日志" as call_log {
  * id : BIGINT <<PK>>
  --
  conversation_id : BIGINT <<FK>>
  * request_type : TINYINT
  latency_ms : INT
  * status : TINYINT
  error_code : VARCHAR(32)
  * created_at : DATETIME
}

entity "admin\n管理员" as admin {
  * id : BIGINT <<PK>>
  --
  * account : VARCHAR(32) <<UK>>
  * password_hash : CHAR(64)
  * role : TINYINT
  last_login_at : DATETIME
  * created_at : DATETIME
}

student ||--o{ document
student ||--o{ conversation
document |o--o{ conversation
conversation ||--o{ message
conversation ||--o{ call_log
command_template |o--o{ message
admin ||--o{ command_template
admin ||--o{ agent_config
@enduml
